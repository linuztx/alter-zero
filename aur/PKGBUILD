# Maintainer: linuztx <linuztx at gmail dot com>

pkgname=alter-zero
pkgver=0.10.0
pkgrel=1
pkgdesc='Agent harness for coding, cybersecurity, and automation'
arch=('x86_64' 'aarch64')
url='https://github.com/linuztx/alter-zero'
license=('Apache-2.0')
depends=('glibc' 'libgcc' 'oniguruma')
makedepends=('cargo')
checkdepends=('git' 'python')
optdepends=('git: filesystem checkpoints and the /diff review')
# makepkg's LTO flags reach only C code, here ring's, which GCC then emits as
# bytecode the rust-lld linker cannot read: every C symbol in ring is lost.
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('86c99782ed500028edca47a235d6fe0f0904cfe73e3210d4de30b03027578a64')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target host-tuple
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # Cargo.toml makes release builds incremental, for quick rebuilds while
  # developing; a package is built once.
  export CARGO_INCREMENTAL=0
  # Link Arch's oniguruma instead of the copy onig_sys would compile.
  export RUSTONIG_SYSTEM_LIBONIG=1
  # Cargo.toml denies every rustc warning, which holds on the toolchain
  # upstream pins; a lint added in Arch's newer rustc must not fail the build.
  export RUSTFLAGS+=' --cap-lints=warn'
  # Cargo strips debug info from release builds. Leave it to makepkg, whose
  # debug option moves it into alter-zero-debug.
  export CARGO_PROFILE_RELEASE_STRIP=false
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  export CARGO_INCREMENTAL=0
  export RUSTONIG_SYSTEM_LIBONIG=1
  # The tests need no debug info, which would make their build gigabytes larger.
  export RUSTFLAGS+=' --cap-lints=warn -C debuginfo=0'
  # These hold rendering to a frame budget (a redraw under 25 ms and the
  # like), which measures the machine building the package; upstream CI
  # enforces them.
  cargo test --frozen -- \
    --skip a_huge_line_with_a_small_edit_refines_fast \
    --skip a_pathological_line_pair_answers_within_the_bound \
    --skip preview_of_a_growing_code_line_is_bounded \
    --skip the_strip_redraw_stays_inside_a_frame_on_a_huge_prose_line \
    --skip a_pathological_line_renders_plain_within_the_frame_budget
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm0755 -t "$pkgdir/usr/bin/" "target/release/$pkgname"
  install -Dm0644 -t "$pkgdir/usr/share/licenses/$pkgname/" LICENSE
  install -Dm0644 -t "$pkgdir/usr/share/doc/$pkgname/" README.md CHANGELOG.md TELEMETRY.md
}
