/target
.claude/
# The /login flow writes API keys to ~/.alter-zero/.env by default (outside the
# repo); this guards a local ./.env (ALTER_ZERO_ENV_FILE / no-HOME fallback) too —
# never commit secrets (docs/llm.md).
.env
# Local Worker secrets and development state never belong in source control.
/telemetry/.dev.vars
/telemetry/.dev.vars.*
!/telemetry/.dev.vars.example
/telemetry/.wrangler/
/telemetry/node_modules/

# scripts/release.sh build packages the release assets here (docs/release.md).
/dist
# Python's bytecode cache (scripts/release/release_server.py under the selftest).
__pycache__/
